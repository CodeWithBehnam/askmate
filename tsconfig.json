{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"lib": [
			"DOM",
			"ES2022"
		],
		"types": [
			"node"
		],
		"skipLibCheck": true
	},
	"include": [
		"**/*.ts"
	],
	"exclude": [
		"node_modules",
		"tests"
	]
}
